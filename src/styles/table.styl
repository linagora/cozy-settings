@require 'settings/breakpoints'

.coz-table
    margin 0 -2rem

    +small-screen()
        .set-table-info-name
            color var(--primaryTextColor)

        .set-table-info-date
            display flex
            gap 0.25em
            align-items center

table.coz-table
    width calc(100% + 4rem)

    th
        font-size 0.75rem
        text-transform uppercase

    td
        font-weight 400

    .set-table-info-name
        font-size 1rem
        overflow-wrap anywhere

    th:first-child
    td:first-child
        padding-left 1rem

    td.row-cell
        padding 0

    .row
        display flex
        justify-content flex-start
        width 100%
        height 4rem

.browser
    padding 1.5rem 0.5rem 1.5rem 1.5rem

.main
    display flex
    flex-direction column
    padding-left 1rem

.title
    font-size 1rem
    color var(--primaryTextColor)

.subtitle
    font-size 0.75rem
    color var(--secondaryTextColor)

.more-menu-infos
    margin-left 0.5rem

.dialog-container
    margin-top 0.75rem
    display block

.dialog-paragraph
    margin 0.25rem
    font-weight 400
