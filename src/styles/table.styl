@require 'settings/breakpoints'

.coz-table
    margin 0 -2rem

    .set-table-os
    .set-table-browser
        flex 0 0 30%

    .set-table-activity
    .set-table-permission
    .set-table-ip
        flex 0 0 15%

    .set-table-date
        flex 0 0 15%

    .set-table-sessions
        // quick fix for cozy-ui table layout issue
        height auto!important //@stylint ignore

    +small-screen()
        .set-table-info-name
            color var(--primaryTextColor)

        .set-table-info-date
            display flex
            gap 0.25em
            align-items center

        .set-table-activity
        .set-table-permission
            display none

table.coz-table
    width calc(100% + 4rem)

    th
        font-size 0.75rem
        text-transform uppercase

    td
        font-size 1rem
        font-weight 400

    .set-table-info-name
        overflow-wrap anywhere

    th:first-child
    td:first-child
        padding-left 1rem

.row
    height 4rem

.browser
    padding 1.5rem 0.5rem 1.5rem 1.5rem

.main
    display flex
    flex-direction column

.title
    font-size 1rem
    color var(--primaryTextColor)

.subtitle
    font-size 0.75rem

.more-menu-infos
    margin-left 0.5rem

.dialog-container
    margin-top 0.75rem
    display block

.dialog-paragraph
    margin 0.25rem
    font-weight 400
